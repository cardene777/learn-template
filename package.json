{
  "name": "learn",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:astro": "node scripts/prepare-astro.mjs",
    "build": "npm run prepare:astro && astro build && rm -rf _site && cp -R dist _site",
    "dev": "npm run prepare:astro && astro dev",
    "check": "npm run prepare:astro && astro check",
    "deploy:cloudflare": "node scripts/prepare-astro.mjs --deploy-cloudflare"
  },
  "dependencies": {
    "astro": "7.2.9",
    "marked": "18.0.11",
    "yaml": "2.9.0"
  }
}

---
import '../../assets/library.css';
import '../../assets/library-fixes.css';
import icon from '../../assets/learn-icon.svg?url';
import LibraryHeader from '../components/LibraryHeader.astro';
const { title = 'Learn', active = '' } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title === 'Learn' ? 'Learn' : `${title} · Learn`}</title>
  <link rel="icon" href={icon} type="image/svg+xml">
</head>
<body class="library-body">
  <LibraryHeader active={active} />
  <slot />
  <footer class="library-footer">template-owner / learn</footer>
  <script>
    import '../../assets/library-status.js';
  </script>
</body>
</html>
